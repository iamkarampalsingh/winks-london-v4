# ─────────────────────────────────────────────────────────────
# WINKS London — environment variables
# Copy to `.env` for local development; add the same keys in
# Vercel → Project → Settings → Environment Variables.
# None of these are exposed to the browser except PUBLIC_* keys.
# ─────────────────────────────────────────────────────────────

# Canonical production URL (no trailing slash). Used for canonical tags,
# Open Graph URLs, sitemap and robots.txt.
PUBLIC_SITE_URL=https://www.your-domain.co.uk

# ── Booking form delivery — configure ONE of the two options ──

# Option A: Resend (https://resend.com) transactional email
RESEND_API_KEY=
# Inbox that receives booking requests
BOOKING_TO_EMAIL=
# Verified sender, e.g. "WINKS London <bookings@your-domain.co.uk>"
BOOKING_FROM_EMAIL=

# Option B: any webhook that accepts a JSON POST (Zapier, Make, Slack, CRM…)
BOOKING_WEBHOOK_URL=
