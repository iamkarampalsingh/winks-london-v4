---
/** Masked image that unveils on scroll, with optional inner parallax. */
import Pic from './Pic.astro';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: string;
  sizes?: string;
  parallax?: boolean;
  dir?: 'up' | 'down' | 'left' | 'right';
  position?: string;
  priority?: boolean;
  class?: string;
}
const { src, alt, ratio = '4 / 5', sizes = '(min-width: 900px) 50vw, 100vw', parallax = true, dir = 'up', position, priority = false, class: cls } = Astro.props;
---
<div class:list={['img-reveal', cls]} style={`--ratio:${ratio}`} data-img-reveal={dir} data-parallax={parallax ? '' : undefined}>
  <div class="img-reveal__inner">
    <Pic src={src} alt={alt} sizes={sizes} position={position} priority={priority} />
  </div>
</div>
