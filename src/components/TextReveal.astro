---
/** Line-by-line masked heading reveal. Text is always present in the HTML. */
interface Props { as?: string; class?: string; delay?: number; id?: string }
const { as: Tag = 'h2', class: cls, delay = 0, id } = Astro.props;
---
<Tag class={cls} id={id} data-split data-delay={delay || undefined}><slot /></Tag>
