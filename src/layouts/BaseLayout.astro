---
import '../styles/global.css';
import Header from '../components/Header.astro';
import DesktopMenu from '../components/DesktopMenu.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import Wordmark from '../components/Wordmark.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  breadcrumbs?: { label: string; href?: string }[];
  schema?: Record<string, unknown>[];
}
const { title, description, image = '/og-image.png', noindex = false, breadcrumbs, schema = [] } = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname.replace(/\/?$/, '/'), origin).href;
const ogImage = new URL(image, origin).href;
const fullTitle = title.includes('WINKS London') ? title : `${title} | WINKS London`;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', origin).href,
    url: new URL('/', origin).href,
    name: site.name,
    description: site.description,
    inLanguage: 'en-GB',
  },
  ...schema,
];
if (breadcrumbs && breadcrumbs.length > 1) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: new URL(c.href ?? Astro.url.pathname, origin).href,
    })),
  });
}
// LocalBusiness schema is only emitted once real contact details exist in src/data/site.ts.
if (site.contact.phone && site.contact.email) {
  graph.push({
    '@type': 'HealthAndBeautyBusiness',
    '@id': new URL('/#business', origin).href,
    name: site.name,
    description: site.description,
    url: new URL('/', origin).href,
    telephone: site.contact.phone,
    email: site.contact.email,
    image: ogImage,
    areaServed: { '@type': 'City', name: 'London' },
    sameAs: site.social.map((s) => s.href),
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#000000" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Progressive enhancement: content is fully visible without JS. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
        try { if (!sessionStorage.getItem('winks-seen')) d.classList.add('first-visit'); } catch (e) {}
        // Failsafe — never leave content hidden if the scripts fail to start.
        setTimeout(function () { if (!d.classList.contains('is-ready')) d.classList.add('no-anim'); }, 7000);
      })();
    </script>
  </head>
  <body id="top">
    <a href="#main" class="skip-link">Skip to main content</a>

    <div class="curtain" data-curtain aria-hidden="true">
      <div class="curtain__content" data-curtain-content>
        <Wordmark tagline class="wordmark--xl" />
        <span class="curtain__line"><i data-curtain-line></i></span>
      </div>
    </div>

    <Header />
    <DesktopMenu />
    <MobileMenu />

    <main id="main" data-page>
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
